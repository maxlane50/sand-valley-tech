# Copy to .env.local for local dev, and set the same values in the Vercel
# project (Settings -> Environment Variables).

# ── Client (bundled into the public JS — read-only access) ──────────────────
# Supabase -> Project Settings -> Data API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only (never bundled — /api holds these) ─────────────────────────
# NO VITE_ PREFIX. A VITE_ prefix would ship these to the browser.
#
# Supabase -> Project Settings -> API keys -> service_role. This key bypasses
# RLS entirely, which is why writes live behind the serverless functions.
SUPABASE_SERVICE_ROLE_KEY=

# Same project URL as above. Only needed if you'd rather not have the server
# fall back to VITE_SUPABASE_URL.
SUPABASE_URL=

# The PIN for /enter. Use 6+ digits: the throttle in api/_lib/handlers.ts is
# per serverless instance, so PIN length is the real defence.
ENTRY_PIN=
